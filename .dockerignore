# Deny all files in the build context by default; only the COPY sources the runtime image needs are allowed.
**
!apps/
!apps/**
!packages/
!packages/**
!.gitleaks.toml
!package.json
!scripts/
!scripts/tools.json

# Even inside allowed directories, dependencies, credentials, reports, and tools stay out of the build context.
**/node_modules
**/.git
**/.tools
**/.terraform
**/reports
**/coverage
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tfstate
**/*.tfstate.*
