<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '26px 64px 18px 64px', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', gap: 6, height: 104 }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F1E19', lineHeight: 1.3 }}>What Is Verified, and What Is Not Yet</Text>
        <Text style={{ fontSize: 17, color: '#6B7A72', lineHeight: 1.5 }}>The right-hand column is not "later": every item states the reason it is blocked</Text>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 14, height: 526 }}>
        <Table
            style={{ width: 1152, height: 424 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#0F1E19' }}
            defaultCellStyle={{
                border: {
                    left: { width: 0, color: '#FFFFFF' },
                    right: { width: 0, color: '#FFFFFF' },
                    top: { width: 0, color: '#FFFFFF' },
                    bottom: { width: 1, color: 'rgba(15,30,25,0.10)' },
                },
            }}
            cells={[
                [
                    { text: 'Verified · re-runnable locally', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#167762' } } },
                    { text: 'Not verified · clear blocker', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#C2410C' } } },
                ],
                ['All 26 automated tests pass', 'GitHub Actions actually running (needs repository permissions)'],
                ['Leaked secret blocked, then passes after the fix (real scanner)', 'CodeQL code scanning (private repository needs a license)'],
                ['Staging-area bypass blocked: still blocked even after the working tree is fixed', 'Image vulnerability scan (blocked by the local environment)'],
                ['Container runs non-root / read-only / resource-limited; health check passes', 'Terraform init / validate (blocked by the local environment)'],
                ['Local RAG answers with citations; refuses questions outside the knowledge base', 'Branch protection and CODEOWNERS (template not applied)'],
            ]}
        />
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', padding: '14px 20px', background: 'rgba(22,119,98,0.07)', borderRadius: 6 }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#167762' }}>So</Text>
            <Text style={{ fontSize: 16, color: '#0F1E19', lineHeight: 1.55 }}>What we can give you now is "locally reproducible evidence," not "everything is already live." All five items on the right need your repository permissions, a license, or an unrestricted machine.</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 12, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#6B7A72' }}>SENTINEL · Secure Development Environment Plan</Text>
        <Text style={{ fontSize: 14, color: '#6B7A72', fontFamily: 'Consolas' }}>13 / 15</Text>
    </Box>
</Slide>
