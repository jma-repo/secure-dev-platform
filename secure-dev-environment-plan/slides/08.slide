<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '26px 64px 18px 64px', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', gap: 6, height: 100 }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F1E19', lineHeight: 1.3 }}>Offline Architecture: One Boundary, Two Pipelines</Text>
        <Text style={{ fontSize: 17, color: '#6B7A72', lineHeight: 1.5 }}>How code gets in and how knowledge gets used both happen inside the same boundary</Text>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 12, height: 520, justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, height: 44, padding: '0 18px', background: 'rgba(194,65,12,0.08)', borderRadius: 6 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#C2410C' }}>Only exit</Text>
            <Text style={{ fontSize: 15, color: '#0F1E19' }}>Patch and image import · time sync · encrypted backup export (all allowlisted and logged)</Text>
        </Box>
        <Box style={{ flexDirection: 'column', height: 262, border: '2px dashed #167762', borderRadius: 10, padding: '14px 16px', gap: 8, position: 'relative' }}>
            <Text style={{ fontSize: 14, color: '#167762', letterSpacing: 2 }}>Internal network boundary</Text>
            <Text style={{ fontSize: 13, color: '#6B7A72' }}>Code pipeline</Text>
            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Dev workspace</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>One container per person</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Internal Git</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>Self-hosted GitLab / Gitea</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>CI runner</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>The five gates run here</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Artifact store</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>Internal package mirror</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: '#167762', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>Runtime</Text>
                    <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.82)' }}>Non-root · read-only</Text>
                </Box>
            </Box>
            <Text style={{ fontSize: 13, color: '#6B7A72', marginTop: 6 }}>Knowledge pipeline</Text>
            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Document store</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>Dept / project / level tags</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Chunking and embedding</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>Local embedding model</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Vector index</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>pgvector / Qdrant</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Local LLM</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>Qwen, loopback-only</Text>
                </Box>
                <Box style={{ width: 204, height: 66, background: 'rgba(22,119,98,0.09)', borderRadius: 6, padding: '8px 12px', flexDirection: 'column', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Answer service</Text>
                    <Text style={{ fontSize: 13, color: '#44534C' }}>Cited answers, or a refusal</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16 }}>
            <Box style={{ flex: 1, padding: '12px 16px', background: 'rgba(15,30,25,0.04)', borderRadius: 6, flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>The boundary is not a firewall</Text>
                <Text style={{ fontSize: 14, color: '#44534C', lineHeight: 1.55 }}>What really controls risk is the outbound channel: deny by default, allow by allowlist, and log every outbound transfer.</Text>
            </Box>
            <Box style={{ flex: 1, padding: '12px 16px', background: 'rgba(15,30,25,0.04)', borderRadius: 6, flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Dependencies need self-hosted mirrors</Text>
                <Text style={{ fontSize: 14, color: '#44534C', lineHeight: 1.55 }}>npm, pip, and container images must have internal mirrors. Otherwise one install hangs and development stops.</Text>
            </Box>
            <Box style={{ flex: 1, padding: '12px 16px', background: 'rgba(15,30,25,0.04)', borderRadius: 6, flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F1E19' }}>Models never go online</Text>
                <Text style={{ fontSize: 14, color: '#44534C', lineHeight: 1.55 }}>Inference runs over local loopback. The address check is hard-coded, and an external address is rejected outright.</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 12, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#6B7A72' }}>SENTINEL · Secure Development Environment Plan</Text>
        <Text style={{ fontSize: 14, color: '#6B7A72', fontFamily: 'Consolas' }}>08 / 15</Text>
    </Box>
</Slide>
