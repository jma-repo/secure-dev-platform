<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '26px 64px 18px 64px', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', gap: 6, height: 104 }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F1E19', lineHeight: 1.3 }}>Three Routes: Data Boundaries Decide the Choice</Text>
        <Text style={{ fontSize: 17, color: '#6B7A72', lineHeight: 1.5 }}>Not "pick whichever is most advanced," but "where is the data allowed to live?"</Text>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 16, height: 526 }}>
        <Table
            style={{ width: 1152, height: 400 }}
            defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#0F1E19' }}
            defaultCellStyle={{
                border: {
                    left: { width: 0, color: '#FFFFFF' },
                    right: { width: 0, color: '#FFFFFF' },
                    top: { width: 0, color: '#FFFFFF' },
                    bottom: { width: 1, color: 'rgba(15,30,25,0.10)' },
                },
            }}
            cells={[
                [
                    { text: 'Dimension', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#0F1E19' } } },
                    { text: 'Microsoft Copilot (M365)', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#0F1E19' } } },
                    { text: 'Self-built on Azure', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#0F1E19' } } },
                    { text: 'Fully offline, self-built', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#167762' } } },
                ],
                ['Where the data lives', 'Your M365 tenant (Microsoft cloud)', 'Your Azure subscription', { text: 'Your own data center', textStyle: { bold: true, color: '#167762' } }],
                ['Where permissions come from', 'Reuses SharePoint / Entra permissions', 'Must be built yourself', { text: 'Must be built yourself', textStyle: { bold: true, color: '#167762' } }],
                ['Speed to go live', 'Fast: once licenses are in place', 'Medium: environment must be built first', 'Slow: needs hardware, images, and models'],
                ['Cost model', 'Per user per month', 'Cloud resources + staff', 'Hardware + staff'],
                [
                    { text: 'Can data stay inside the network?', textStyle: { bold: true } },
                    { text: 'No: data goes to the Microsoft cloud', textStyle: { bold: true, color: '#C2410C' } },
                    { text: 'No: data goes to Azure', textStyle: { bold: true, color: '#C2410C' } },
                    { text: 'Yes: fully inside the network', textStyle: { bold: true, color: '#167762' } },
                ],
                ['Best for', 'Already on M365 and comfortable with the cloud', 'Needs customization and can use the cloud', 'Data must never leave the network'],
            ]}
        />
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', padding: '14px 20px', background: 'rgba(194,65,12,0.08)', borderRadius: 6 }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C2410C' }}>Conclusion</Text>
            <Text style={{ fontSize: 16, color: '#0F1E19', lineHeight: 1.55 }}>"Stay inside the network" and "use cloud Copilot" are mutually exclusive. Decide this one first, or the architecture, budget, and timeline all have to be redone.</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 12, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#6B7A72' }}>SENTINEL · Secure Development Environment Plan</Text>
        <Text style={{ fontSize: 14, color: '#6B7A72', fontFamily: 'Consolas' }}>07 / 15</Text>
    </Box>
</Slide>
