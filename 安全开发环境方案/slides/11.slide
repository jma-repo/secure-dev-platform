<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '26px 64px 18px 64px', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', gap: 6, height: 104 }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F1E19', lineHeight: 1.3 }}>完全离线：能做到，代价是什么</Text>
        <Text style={{ fontSize: 17, color: '#6B7A72', lineHeight: 1.5 }}>离线不是买断，是把外网依赖换成一条受控的窄通道</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 40, height: 526 }}>
        <Box style={{ width: 676, flexDirection: 'column', gap: 14 }}>
            <Box style={{ flexDirection: 'row', paddingBottom: 8, borderBottom: '2px solid #0F1E19' }}>
                <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#0F1E19' }}>能力</Text>
                <Text style={{ flex: 1.35, fontSize: 15, fontWeight: 'bold', color: '#0F1E19' }}>离线之后的代价</Text>
            </Box>
            <Box style={{ flexDirection: 'row', paddingBottom: 10, borderBottom: '1px solid rgba(15,30,25,0.10)' }}>
                <Text style={{ flex: 1, fontSize: 16, color: '#0F1E19' }}>代码托管</Text>
                <Text style={{ flex: 1.35, fontSize: 15, color: '#44534C', lineHeight: 1.5 }}>自建 GitLab / Gitea，要有人维护、打补丁、做备份</Text>
            </Box>
            <Box style={{ flexDirection: 'row', paddingBottom: 10, borderBottom: '1px solid rgba(15,30,25,0.10)' }}>
                <Text style={{ flex: 1, fontSize: 16, color: '#0F1E19' }}>依赖安装</Text>
                <Text style={{ flex: 1.35, fontSize: 15, color: '#44534C', lineHeight: 1.5 }}>npm / pip / 镜像走内网源，新包要人工审批后导入</Text>
            </Box>
            <Box style={{ flexDirection: 'row', paddingBottom: 10, borderBottom: '1px solid rgba(15,30,25,0.10)' }}>
                <Text style={{ flex: 1, fontSize: 16, color: '#0F1E19' }}>安全补丁</Text>
                <Text style={{ flex: 1.35, fontSize: 15, color: '#44534C', lineHeight: 1.5 }}>摆渡导入 + 先扫描再放行，通常滞后数天到数周</Text>
            </Box>
            <Box style={{ flexDirection: 'row' }}>
                <Text style={{ flex: 1, fontSize: 16, color: '#0F1E19' }}>模型更新</Text>
                <Text style={{ flex: 1.35, fontSize: 15, color: '#44534C', lineHeight: 1.5 }}>权重离线下载、校验、再分发，不能点一下"更新"</Text>
            </Box>
            <Box style={{ marginTop: 'auto', padding: '12px 16px', background: 'rgba(22,119,98,0.07)', borderRadius: 6 }}>
                <Text style={{ fontSize: 15, color: '#0F1E19', lineHeight: 1.6 }}>所以真正的设计题不是"能不能离线"，而是"离线之后，谁来承担这条窄通道的运维"。</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 18 }}>
            <Text style={{ fontSize: 14, color: '#167762', letterSpacing: 2 }}>坏了怎么办</Text>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1E19' }}>备份</Text>
                <Text style={{ fontSize: 15, color: '#44534C', lineHeight: 1.6 }}>仓库镜像 + 文档库 + 密钥，加密后外送一份。只留一份在原机房的，不叫备份。</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1E19' }}>重建</Text>
                <Text style={{ fontSize: 15, color: '#44534C', lineHeight: 1.6 }}>环境用代码描述（IaC + 镜像），机器坏了是重装，不是重搭。恢复时间从几天压到几小时。</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F1E19' }}>演练</Text>
                <Text style={{ fontSize: 15, color: '#44534C', lineHeight: 1.6 }}>每季度真恢复一次。没演练过的备份，只能算"希望"。</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4, marginTop: 6, padding: 14, background: 'rgba(194,65,12,0.08)', borderRadius: 6 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C2410C' }}>需要你给两个数</Text>
                <Text style={{ fontSize: 15, color: '#0F1E19', lineHeight: 1.6 }}>RPO：最多能丢多少数据；RTO：多久必须恢复。这两个数直接决定备份频率和投入。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, right: 64, bottom: 12, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#6B7A72' }}>SENTINEL · 安全开发环境方案</Text>
        <Text style={{ fontSize: 14, color: '#6B7A72', fontFamily: 'Consolas' }}>11 / 15</Text>
    </Box>
</Slide>
